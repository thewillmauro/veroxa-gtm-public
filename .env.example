# Copy to .env (gitignored) and fill in. Never commit real values.

# veroxa-gtm project (your-project-ref), NOT the Veroxa app project.
# Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Only used by the integration test that proves anon is denied.
SUPABASE_ANON_KEY=

# Only if the API key isn't scoped to a workspace (Console > Settings > Workspaces, wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_API_KEY=
# From the Clay table's Webhook source (M3). Must be a clay.com URL.
CLAY_WEBHOOK_URL=
# From the GTM Decision Makers table's Webhook source (docs/clay/dm-table-setup.md).
CLAY_DM_WEBHOOK_URL=
# Only if the Clay webhook source has an auth token enabled.
CLAY_WEBHOOK_AUTH_TOKEN=
# At least 16 chars. Generate: openssl rand -hex 32
CLAY_CALLBACK_SECRET=
HUBSPOT_PRIVATE_APP_TOKEN=

LOG_LEVEL=info
